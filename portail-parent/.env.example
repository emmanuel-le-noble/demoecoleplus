# ==========================================================================
# Ecole Plus — Portail Parent — Variables d'environnement
# ==========================================================================
# Copiez ce fichier en .env et remplissez les valeurs.
# Ne versionnez JAMAIS le fichier .env (exclu via .gitignore).
# ==========================================================================

# ─── APPLICATION ─────────────────────────────────────────────────────────
APP_NAME="Ecole Plus"
APP_URL="http://localhost/demoecoleplus/portail-parent"
APP_ENV="development"
APP_DEBUG="true"
APP_KEY="CHANGE_ME_64_CHARS_RANDOM_HEX"

# ─── BASE DE DONNÉES ────────────────────────────────────────────────────
DB_HOST="localhost"
DB_NAME="ecole_plus"
DB_USER="root"
DB_PASS=""

# ─── SESSION ─────────────────────────────────────────────────────────────
# Clé AES-256-GCM pour le chiffrement des sessions BDD (64 caractères hex)
ECOLEPLUS_SESSION_KEY="CHANGE_ME_64_CHARS_HEX_FOR_SESSION_ENCRYPTION"

# ─── NETTOYAGE DES SESSIONS ──────────────────────────────────────────────
# Clé secrète pour autoriser l'exécution de session_cleanup.php
ECOLEPLUS_CLEANUP_KEY="CHANGE_ME_CLEANUP_SECRET"

# ─── WEBSOCKET ───────────────────────────────────────────────────────────
# URL du serveur WebSocket (Ratchet)
ECOLEPLUS_WS_URL="ws://localhost:8080"
# Secret partagé entre le serveur WS et les clients
ECOLEPLUS_WS_SECRET="CHANGE_ME_WS_SECRET"

# ─── GOOGLE OAuth ────────────────────────────────────────────────────────
# Laissez vide si OAuth Google n'est pas configuré
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── EMAIL ───────────────────────────────────────────────────────────────
# Adresse d'expédition pour les emails (reset mot de passe, OTP, etc.)
MAIL_FROM="noreply@ecoleplus.tg"
# Serveur SMTP (requis pour l'envoi d'emails)
MAIL_SMTP_HOST="smtp.gmail.com"
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=""
MAIL_SMTP_PASS=""
MAIL_SMTP_ENCRYPTION="tls"

# ─── OTP (Double authentification) ──────────────────────────────────────
# Activer la double authentification OTP (true/false)
OTP_ENABLED=true
# Longueur du code (défaut: 6 chiffres)
OTP_LENGTH=6
# Durée de validité en secondes (défaut: 300 = 5 min)
OTP_EXPIRATION=300
# Nombre max de tentatives avant blocage (défaut: 5)
OTP_MAX_ATTEMPTS=5
# Délai entre deux envois en secondes (défaut: 60 = 1 min)
OTP_RESEND_DELAY=60

# ─── SMS ─────────────────────────────────────────────────────────────────
# Activer l'envoi SMS (true/false)
SMS_ENABLED=false
# Fournisseur: twilio, africastalking, bulksms, ou laisser vide
SMS_PROVIDER=""
# URL API du fournisseur SMS
SMS_API_URL=""
# Clé API / Account SID du fournisseur
SMS_API_KEY=""
# Secret API (selon fournisseur, ex: Twilio Auth Token)
# SMS_API_SECRET=""
# Nom ou numéro expéditeur
SMS_SENDER="EcolePlus"
